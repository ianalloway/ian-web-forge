{
  "name": "ian-web-forge",
  "private": true,
  "version": "1.0.0",
  "description": "Matrix-themed portfolio site for Ian Alloway (ianalloway.xyz) — ML engineer & data scientist. React + TypeScript + Vite.",
  "author": "Ian Alloway <ian@allowayllc.com>",
  "license": "MIT",
  "homepage": "https://ianalloway.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/ianalloway/ian-web-forge.git"
  },
  "bugs": {
    "url": "https://github.com/ianalloway/ian-web-forge/issues"
  },
  "keywords": [
    "portfolio",
    "react",
    "typescript",
    "vite",
    "machine-learning",
    "sports-analytics",
    "personal-website"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:forms": "node scripts/check-netlify-forms.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "eslint . && npm run typecheck && vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.66.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.2",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
